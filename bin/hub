#!/usr/bin/env python3
"""Run directly from a pinned Core checkout, without installing a package."""
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("Agent Hub requires Python 3.11+. Run: python3.13 bin/hub --help")
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from agent_hub.cli import main

main()

